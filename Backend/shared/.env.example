# LinkedIn OIDC client used by the LinkedIn auth server
LINKEDIN_CLIENT_ID=add-your-client-id
LINKEDIN_CLIENT_SECRET=add-your-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:4173/api/signin/callback
# Use the registered HTTPS public callback URL in production.

# Shared by the gateway and internal auth services
AUTH_INTERNAL_TOKEN=replace-with-a-shared-secret
